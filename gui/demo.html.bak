<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>ArterialAge</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Sora:wght@200;300;400;600;700&family=JetBrains+Mono:wght@300;400;600&display=swap');
:root{
  --void:#04060D; --card:rgba(255,255,255,.035); --edge:rgba(255,255,255,.085);
  --ear:#22D3EE; --wri:#F472B6;
  --g:#34D399; --o:#FBBF24; --r:#FB5D5D;
  --ink:#EDF2FC; --dim:#8598BC; --faint:#44527090;
  --mono:"JetBrains Mono",ui-monospace,monospace; --sans:"Sora",system-ui,sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{background:var(--void);color:var(--ink);font-family:var(--sans);overflow:hidden;
  -webkit-font-smoothing:antialiased}
#wash{position:fixed;inset:0;pointer-events:none;transition:background 1.5s ease;
  background:radial-gradient(140% 100% at 50% -30%,rgba(52,211,153,.13),transparent 65%)}
.wrap{position:relative;height:100vh;display:flex;flex-direction:column;padding:24px 34px 26px;gap:18px}

.hdr{display:flex;justify-content:space-between;align-items:center;flex:0 0 auto}
.brand{font:700 13px/1 var(--sans);letter-spacing:.38em;text-transform:uppercase}
.brand span{color:var(--dim);font-weight:200}
.tags{display:flex;gap:8px}
.tag{font:400 9px/1 var(--mono);letter-spacing:.15em;text-transform:uppercase;padding:7px 12px;
  border-radius:100px;border:1px solid var(--edge);color:var(--dim)}
.tag.on{color:var(--g);border-color:rgba(52,211,153,.4)}
.tag.off{color:var(--r);border-color:rgba(251,93,93,.4)}
.dot{display:inline-block;width:5px;height:5px;border-radius:50%;background:currentColor;
  margin-right:6px;vertical-align:1px;animation:bp 2.2s ease-in-out infinite}
@keyframes bp{0%,100%{opacity:.28}50%{opacity:1}}

/* ---- TOP: full-width waveform ---- */
.top{flex:1 1 40%;min-height:200px;display:grid;grid-template-columns:2fr 1fr;gap:18px}
.wave{border-radius:20px;border:1px solid var(--edge);
  background:linear-gradient(180deg,rgba(255,255,255,.04),rgba(255,255,255,.012));
  position:relative;overflow:hidden}
.wave .hd{position:absolute;top:16px;left:24px;right:24px;display:flex;
  justify-content:space-between;align-items:baseline;z-index:2;pointer-events:none}
.k{font:400 9px/1 var(--mono);letter-spacing:.2em;text-transform:uppercase;color:var(--dim)}
.wave .r{font:400 10px/1 var(--mono);color:var(--dim)}
canvas{display:block;width:100%;height:100%}

/* ---- BOTTOM: three equal thirds ---- */
.grid{flex:1 1 54%;min-height:240px;display:grid;grid-template-columns:1.05fr 1fr;gap:18px}
.card{border-radius:20px;border:1px solid var(--edge);background:var(--card);
  padding:22px 26px;overflow:auto}
.card::-webkit-scrollbar{width:0}

/* 1: tier + domains */
.tierwrap{display:flex;align-items:center;gap:20px;margin:14px 0 20px}
.tn{font:200 118px/.78 var(--sans);letter-spacing:-.06em;transition:color .9s ease;
  font-variant-numeric:tabular-nums}
.tside .of{font:400 13px/1 var(--mono);color:var(--faint)}
.tside .lb{font:600 14px/1.3 var(--sans);margin-top:8px;max-width:150px}
.tside .rel{font:400 11px/1.4 var(--mono);color:var(--dim);margin-top:9px}
.tside .rel b{font-weight:600;font-size:14px}
/* vertical severity columns: HEIGHT encodes the age-sex percentile, colour
   encodes the band. Unmeasured domains keep their column as an empty outline
   so the reader can see WHAT WAS NOT LOOKED AT, not just what was found. */
.sevwrap{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;align-items:end;
  height:132px;margin-top:4px;position:relative}
.thr{position:absolute;left:0;right:0;border-top:1px dashed rgba(255,255,255,.16);
  pointer-events:none}
.thr span{position:absolute;right:0;top:-13px;font:400 7.5px/1 var(--mono);
  letter-spacing:.08em;color:var(--faint)}
.col{display:flex;flex-direction:column;justify-content:flex-end;height:100%;position:relative}
.col .bar{width:100%;border-radius:7px 7px 3px 3px;transition:height .9s cubic-bezier(.34,1.1,.4,1),
  background .6s ease;position:relative;min-height:3px}
.col .bar.empty{background:transparent;border:1px dashed rgba(255,255,255,.16);height:100%!important}
.col .pc{position:absolute;left:0;right:0;text-align:center;font:600 12px/1 var(--mono);
  transition:color .6s ease}
.col .lb{font:400 9px/1.35 var(--sans);color:var(--dim);text-align:center;margin-top:9px;
  min-height:24px}
.col .lb i{display:block;font:400 7.5px/1.3 var(--mono);font-style:normal;letter-spacing:.08em;
  text-transform:uppercase;margin-top:3px}

/* 2: measurements */
.ms{margin-bottom:19px}
.ms .lb{font:400 9px/1 var(--mono);letter-spacing:.16em;text-transform:uppercase;color:var(--dim)}
.ms .vl{font:200 40px/1 var(--sans);font-variant-numeric:tabular-nums;margin:7px 0 3px}
.ms .vl em{font:400 13px/1 var(--mono);font-style:normal;color:var(--dim);margin-left:6px;
  letter-spacing:0}
.ms .nt{font:400 9.5px/1.4 var(--mono);color:var(--faint)}
.ms.off .vl{color:var(--faint)}

/* 3: GP report */
.rep .sec{padding:11px 0;border-bottom:1px solid rgba(255,255,255,.055)}
.rep .h{display:flex;justify-content:space-between;align-items:baseline;gap:10px;margin-bottom:5px}
.rep .h .t{font:600 8.5px/1 var(--mono);letter-spacing:.17em;text-transform:uppercase}
.rep .h .f{font:600 8px/1 var(--mono);letter-spacing:.12em;padding:3px 8px;border-radius:100px}
.rep .m{font:400 9.5px/1.4 var(--mono);color:var(--dim);margin-bottom:4px}
.rep .d{font:300 11px/1.6 var(--sans);opacity:.88}
.rep .imp{margin-top:14px;padding:14px 16px;border-radius:14px;background:rgba(255,255,255,.045)}
.rep .imp .t{font:600 8.5px/1 var(--mono);letter-spacing:.17em;text-transform:uppercase;
  color:var(--dim);margin-bottom:8px}
.rep .imp .b{font:300 11.5px/1.65 var(--sans)}
.rep .imp b{font-weight:600}
.rep .na{font:300 9px/1.6 var(--mono);color:var(--faint);margin-top:11px}

#wait{position:fixed;inset:0;display:grid;place-items:center;text-align:center;
  background:var(--void);z-index:50;transition:opacity .6s ease}
#wait.gone{opacity:0;pointer-events:none}
#wait h2{font:200 32px/1.3 var(--sans);margin-bottom:14px}
#wait p{font:300 11px/2 var(--mono);color:var(--dim)}
#wait code{color:var(--ear)}
.ring{width:62px;height:62px;margin:0 auto 28px;border-radius:50%;
  border:1px solid rgba(34,211,238,.22);position:relative}
.ring::after{content:"";position:absolute;inset:-1px;border-radius:50%;border:1px solid transparent;
  border-top-color:var(--ear);animation:sp 1.5s linear infinite}
@keyframes sp{to{transform:rotate(360deg)}}
@media(prefers-reduced-motion:reduce){.ring::after,.dot{animation:none}}
@media(max-width:1150px){.grid,.top{grid-template-columns:1fr}.tn{font-size:80px}}
</style></head><body>
<div id="wash"></div>
<div id="wait"><div><div class="ring"></div><h2>Awaiting measurement</h2>
<p><code>python push.py --set age=71 sex=1 dtau=0.00095 HR_rest=78 RR_irregularity=0.24</code></p></div></div>

<div class="wrap">
  <div class="hdr"><div class="brand">Arterial<span>Age</span></div>
    <div class="tags"><span class="tag" id="link"><span class="dot"></span>connecting</span>
      <span class="tag" id="src">—</span></div></div>

  <div class="top">
    <div class="wave"><div class="hd">
      <span class="k">Photoplethysmogram · left + right ear · intersecting tangents</span>
      <span class="r" id="wr"></span></div><canvas id="ppg"></canvas></div>
    <div class="wave"><div class="hd">
      <span class="k">Foot-to-foot · Δτ</span>
      <span class="r" id="zr"></span></div><canvas id="zoom"></canvas></div>
  </div>

  <div class="grid">
    <div class="card">
      <div class="k">Risk tier</div>
      <div class="tierwrap">
        <div class="tn" id="tn">—</div>
        <div class="tside"><div class="of" id="tof">of 2</div>
          <div class="lb" id="tlb"></div>
          <div class="rel" id="trel"></div></div>
      </div>
      <div class="k" style="margin-bottom:9px">Domain severity · age–sex percentile</div>
      <div id="doms"></div>
    </div>

    <div class="card">
      <div class="k" style="margin-bottom:18px">Measurements</div>
      <div id="meas"></div>
    </div>

</div>
  </div>
</div>

<script>
const API=location.origin,$=i=>document.getElementById(i);
let META=null,S=null,T0=performance.now();
const COL=["#34D399","#FBBF24","#FB5D5D"],RGB=["52,211,153","251,191,36","251,93,93"];
const FS=250, DT_DEF=0.002569;

/* physiologically shaped PPG: systolic + reflected + diastolic */
function ppg(ph){ph=((ph%1)+1)%1;
  return Math.exp(-Math.pow((ph-.26)/.105,2))+.42*Math.exp(-Math.pow((ph-.50)/.135,2))
       +.16*Math.exp(-Math.pow((ph-.70)/.160,2));}

/* INTERSECTING TANGENTS — the fiducial the sig-proc spec mandates:
   t_foot = t_m - (y_m - y_min)/s , s = slope at maximum upstroke */
function footTangent(y,t){
  let iMin=0;for(let i=1;i<y.length;i++)if(y[i]<y[iMin])iMin=i;
  let iMax=iMin+1,best=-1e9;
  for(let i=Math.max(iMin+1,1);i<y.length-1;i++){const d=y[i+1]-y[i-1];if(d>best){best=d;iMax=i;}}
  const s=(y[iMax+1]-y[iMax-1])/(t[iMax+1]-t[iMax-1]);
  if(!isFinite(s)||Math.abs(s)<1e-9)return{t:t[iMin],iMin,iMax,s:0,yMin:y[iMin]};
  return{t:t[iMax]-(y[iMax]-y[iMin])/s,iMin,iMax,s,yMin:y[iMin]};
}
function cv(c){const r=c.getBoundingClientRect(),d=devicePixelRatio||1;
  if(Math.abs(c.width-r.width*d)>1){c.width=r.width*d;c.height=r.height*d;}
  const x=c.getContext("2d");x.setTransform(d,0,0,d,0,0);return{x,w:r.width,h:r.height};}

function draw(now){
  drawZoom(now);
  const {x,w,h}=cv($("ppg"));x.clearRect(0,0,w,h);
  const hr=(S&&S.features.HR_rest)||62,beat=60/hr;
  const dtau=(S&&S.features.dtau!=null)?S.features.dtau:DT_DEF;
  const rr=(S&&S.features.RR_irregularity)||0.03;
  const tier=S?Math.min(S.result.tier.tier,2):0;
  const t=(now-T0)/1000, span=2.6, base=h*.80, amp=h*.46;

  x.strokeStyle="rgba(255,255,255,.03)";x.lineWidth=1;
  for(let i=1;i<10;i++){x.beginPath();x.moveTo(i*w/10,0);x.lineTo(i*w/10,h);x.stroke();}

  /* RR irregularity actually perturbs the beat spacing */
  const jit=k=>1+rr*Math.sin(k*2.399)*1.5;
  const phase=tt=>{let acc=0,k=0;while(acc<tt&&k<4000){acc+=beat*jit(k);k++;}
    const prev=acc-beat*jit(k-1);return{ph:(tt-prev)/Math.max(acc-prev,1e-6),foot:prev};};

  for(const [col,off] of [["#F472B6",dtau],["#22D3EE",0]]){
    x.beginPath();x.strokeStyle=col;x.lineWidth=2.2;x.shadowBlur=13;x.shadowColor=col;
    for(let px=0;px<=w;px++){const tt=Math.max(t-span+(px/w)*span-off,0);
      const y=base-amp*ppg(phase(tt).ph);px?x.lineTo(px,y):x.moveTo(px,y);}
    x.stroke();x.shadowBlur=0;}

  /* ---- the tangent construction, drawn ON the live trace ---- */
  const anchor=t-0.62;                      /* a foot that has fully scrolled in */
  const f0=phase(anchor).foot;
  const px=v=>w-((t-v)/span)*w;
  if(px(f0)>110&&px(f0)<w-140){
    const N=70,t0=f0-0.055,ts=[],ye=[],yw=[];
    for(let i=0;i<N;i++){const tt=t0+i/FS;ts.push(tt);
      ye.push(ppg(phase(tt).ph));yw.push(ppg(phase(Math.max(tt-dtau,0)).ph));}
    const fe=footTangent(ye,ts),fw=footTangent(yw,ts);
    const Y=v=>base-amp*v;
    for(const [f,arr,col] of [[fe,ye,"#22D3EE"],[fw,yw,"#F472B6"]]){
      /* horizontal through the diastolic minimum */
      x.strokeStyle=col;x.globalAlpha=.55;x.lineWidth=1;x.setLineDash([3,4]);
      x.beginPath();x.moveTo(px(ts[0])-30,Y(f.yMin));x.lineTo(px(ts[N-1])+30,Y(f.yMin));x.stroke();
      /* tangent at maximum upstroke slope, extended down to the intersection */
      const a=f.t-0.045,b=ts[f.iMax]+0.028;
      x.setLineDash([]);x.globalAlpha=.85;x.lineWidth=1.3;
      x.beginPath();
      x.moveTo(px(a),Y(arr[f.iMax]+f.s*(a-ts[f.iMax])));
      x.lineTo(px(b),Y(arr[f.iMax]+f.s*(b-ts[f.iMax])));
      x.stroke();x.globalAlpha=1;
      /* the intersection = the foot */
      x.fillStyle=col;x.beginPath();x.arc(px(f.t),Y(f.yMin),4.2,0,7);x.fill();
      x.strokeStyle="rgba(4,6,13,.9)";x.lineWidth=1.5;x.stroke();
    }
    /* the measured gap */
    const mid=(px(fe.t)+px(fw.t))/2, yb=Y(fe.yMin)+26;
    x.strokeStyle=COL[tier];x.lineWidth=1.5;
    x.beginPath();x.moveTo(px(fe.t),yb);x.lineTo(px(fw.t),yb);x.stroke();
    for(const f of [fe,fw]){x.beginPath();x.moveTo(px(f.t),yb-5);x.lineTo(px(f.t),yb+5);x.stroke();}
    x.fillStyle=COL[tier];x.font="600 13px JetBrains Mono, monospace";x.textAlign="center";
    x.fillText(`Δτ ${((fw.t-fe.t)*1000).toFixed(2)} ms`,mid,yb+21);x.textAlign="left";
  }
  x.fillStyle="rgba(34,211,238,.9)";x.font="400 9px JetBrains Mono, monospace";
  x.fillText("LEFT EAR",22,h-16);
  x.fillStyle="rgba(244,114,182,.9)";x.fillText("RIGHT EAR",76,h-16);
  $("wr").innerHTML=`${hr.toFixed(0)} bpm · ${FS} Hz · <span style="color:${COL[tier]}">`
    +`Δτ ${(dtau*1000).toFixed(2)} ms</span>`;
  requestAnimationFrame(draw);
}

/* ---- FOOT-TO-FOOT SNAPSHOT ----------------------------------------------
   A frozen, magnified view of ONE foot region. The live trace shows the
   construction in motion; this shows it still, at a time scale where a 1-3 ms
   gap is actually visible. At 250 Hz one sample is 4 ms and dtau's whole
   population spread is 3.2 ms -- so without magnification the two feet sit on
   top of each other and the measurement is invisible. The dots are computed by
   the same footTangent() the live trace uses.                              */
function drawZoom(now){
  const {x,w,h}=cv($("zoom"));x.clearRect(0,0,w,h);
  if(!S){$("zr").textContent="";return;}
  const dtau=S.features.dtau!=null?S.features.dtau:DT_DEF;
  const hr=S.features.HR_rest||62,beat=60/hr;
  const rr=S.features.RR_irregularity||0.03;
  const tier=Math.min(S.result.tier.tier,2);
  const t=(now-T0)/1000;
  /* LIVE: follow the most recent foot that has fully scrolled in, so the
     window advances beat by beat rather than sitting on a frozen sample.
     Both channels are LEFT and RIGHT EAR -- same transmission morphology,
     which is why cross-checking two feet of identical shape is meaningful. */
  const jit=k=>1+rr*Math.sin(k*2.399)*1.5;
  const phase=tt=>{let acc=0,k=0;while(acc<tt&&k<6000){acc+=beat*jit(k);k++;}
    const prev=acc-beat*jit(k-1);return{ph:(tt-prev)/Math.max(acc-prev,1e-6),foot:prev};};
  const anchor=phase(Math.max(t-0.55,0.001)).foot;
  const N=56,t0=anchor-0.030,ts=[],yl=[],yr=[];
  for(let i=0;i<N;i++){const tt=t0+i/FS;ts.push(tt);
    yl.push(ppg(phase(Math.max(tt,0)).ph));
    yr.push(ppg(phase(Math.max(tt-dtau,0)).ph));}
  const fl=footTangent(yl,ts),fr=footTangent(yr,ts);
  const meas=(fr.t-fl.t)*1000;
  const L=44,R=w-22,TP=h*.32,BT=h*.76;
  const X=v=>L+((v-ts[0])/(ts[N-1]-ts[0]))*(R-L);
  const lo=Math.min(...yl,...yr),hi=Math.max(...yl,...yr);
  const Y=v=>BT-((v-lo)/Math.max(hi-lo,1e-6))*(BT-TP);
  x.strokeStyle="rgba(255,255,255,.03)";x.lineWidth=1;
  for(let i=1;i<5;i++){const gx=L+i*(R-L)/5;
    x.beginPath();x.moveTo(gx,TP-14);x.lineTo(gx,BT+14);x.stroke();}
  x.fillStyle=`rgba(${RGB[tier]},.09)`;
  x.fillRect(X(fl.t),TP-12,Math.max(X(fr.t)-X(fl.t),1),BT-TP+26);
  for(const [arr,col] of [[yr,"#F472B6"],[yl,"#22D3EE"]]){
    x.beginPath();x.strokeStyle=col;x.lineWidth=2.2;x.shadowBlur=11;x.shadowColor=col;
    arr.forEach((v,i)=>i?x.lineTo(X(ts[i]),Y(v)):x.moveTo(X(ts[i]),Y(v)));
    x.stroke();x.shadowBlur=0;}
  for(const [f,arr,col] of [[fl,yl,"#22D3EE"],[fr,yr,"#F472B6"]]){
    x.strokeStyle=col;x.globalAlpha=.45;x.lineWidth=1;x.setLineDash([3,4]);
    x.beginPath();x.moveTo(L-14,Y(f.yMin));x.lineTo(R+6,Y(f.yMin));x.stroke();
    x.setLineDash([]);x.globalAlpha=.9;x.lineWidth=1.3;
    const a=f.t-0.016,b=ts[f.iMax]+0.009;
    x.beginPath();
    x.moveTo(X(a),Y(arr[f.iMax]+f.s*(a-ts[f.iMax])));
    x.lineTo(X(b),Y(arr[f.iMax]+f.s*(b-ts[f.iMax])));
    x.stroke();x.globalAlpha=1;
    x.fillStyle=col;x.beginPath();x.arc(X(f.t),Y(f.yMin),4.4,0,7);x.fill();
    x.strokeStyle="rgba(4,6,13,.95)";x.lineWidth=1.7;x.stroke();}
  const yb=BT+18;
  x.strokeStyle=COL[tier];x.lineWidth=1.5;
  x.beginPath();x.moveTo(X(fl.t),yb);x.lineTo(X(fr.t),yb);x.stroke();
  for(const f of [fl,fr]){x.beginPath();x.moveTo(X(f.t),yb-5);x.lineTo(X(f.t),yb+5);x.stroke();}
  x.fillStyle=COL[tier];x.font="600 17px JetBrains Mono, monospace";x.textAlign="center";
  x.fillText(`${meas.toFixed(2)} ms`,Math.min(Math.max((X(fl.t)+X(fr.t))/2,52),w-52),yb+23);
  x.textAlign="left";
  x.fillStyle="rgba(133,152,188,.8)";x.font="400 8.5px JetBrains Mono, monospace";
  x.fillText("L foot",10,Y(fl.yMin)-6);x.fillText("R foot",10,Y(fr.yMin)+12);
  $("zr").innerHTML=`${((ts[N-1]-ts[0])*1000).toFixed(0)} ms · live`;
}

async function boot(){
  try{META=await(await fetch(API+"/model")).json();}
  catch(e){$("link").textContent="no server";$("link").className="tag off";return;}
  const es=new EventSource(API+"/stream");
  es.onopen=()=>{$("link").innerHTML='<span class="dot"></span>live';$("link").className="tag on";};
  es.onerror=()=>{$("link").innerHTML='<span class="dot"></span>lost';$("link").className="tag off";};
  es.addEventListener("subject",e=>{const d=JSON.parse(e.data);
    if(d.waiting||!d.current){$("wait").classList.remove("gone");S=null;return;}
    $("wait").classList.add("gone");S=d.current;render(d.current);});
  requestAnimationFrame(draw);
}

function render(rec){
  const r=rec.result,fv=rec.features,t=r.tier,tier=Math.min(t.tier,2),C=COL[tier];
  $("src").textContent=`${rec.source} · #${rec.seq}`;
  $("wash").style.background=
    `radial-gradient(140% 100% at 50% -30%,rgba(${RGB[tier]},.15),transparent 65%)`;

  /* --- 1. tier, big --- */
  $("tn").textContent=tier;$("tn").style.color=C;
  $("tlb").textContent=t.label;
  $("trel").innerHTML=`<b style="color:${C}">${r.multiple_of_population.toFixed(1)}×</b> `
    +`the population rate<br><span style="color:var(--faint)">`
    +`${(100*r.risk_index).toFixed(2)}% index · 95% ${(100*r.lo).toFixed(2)}–`
    +`${(100*r.hi).toFixed(2)}% · base ${(100*r.base_prevalence).toFixed(2)}%</span>`;

  /* three columns, always all three, height = severity percentile */
  const DSHORT={"Arterial load":"Vascular","Exertional reserve":"Cardiac",
                "Atrial-electrical":"Atrial"};
  const ents=Object.entries(t.domains||{});
  $("doms").innerHTML=
    `<div class="sevwrap">
       <div class="thr" style="bottom:84%"><span>84th</span></div>
       <div class="thr" style="bottom:97.7%"><span>97.7th</span></div>`
    + ents.map(([n,d])=>{
        const p=d.severity_pct,sc=Math.min(d.score||0,2),c=COL[sc];
        const drv=d.driver?d.driver.replace(/_/g," ").replace("dtau","\u0394\u03c4"):"";
        if(p==null) return `<div class="col">
          <div class="pc" style="bottom:calc(100% + 6px);color:var(--faint)">—</div>
          <div class="bar empty"></div>
          <div class="lb">${DSHORT[n]||n}<i>not measured</i></div></div>`;
        const hpc=Math.max(Math.min(p,100),4);
        return `<div class="col">
          <div class="pc" style="bottom:calc(${hpc}% + 6px);color:${c}">${p.toFixed(0)}</div>
          <div class="bar" style="height:${hpc}%;
            background:linear-gradient(180deg,${c},rgba(${RGB[sc]},.28));
            box-shadow:0 0 18px rgba(${RGB[sc]},.30)"></div>
          <div class="lb">${DSHORT[n]||n}<i style="color:${c}">${d.state}</i></div></div>`;
      }).join("")
    + `</div>`;

  /* --- 2. measurements --- */
  const M=[["Δτ transit difference",fv.dtau==null?null:fv.dtau*1000,"ms",2,"dtau"],
    ["Heart rate",fv.HR_rest,"bpm",0,"HR_rest"],
    ["RR irregularity",fv.RR_irregularity,"rmssd/rr",3,"RR_irregularity"],
    ["Nocturnal dipping",fv.Nocturnal_PTT_dipping,"night/day",3,"Nocturnal_PTT_dipping"],
    ["ΔPWV reserve",fv.dPWV_reserve,"residual",3,"dPWV_reserve"]];
  $("meas").innerHTML=M.map(([l,v,u,dp,k])=>{
    const p=META.priors[k];let z=null;
    if(v!=null&&p){const raw=k==="dtau"?v/1000:v;z=-((raw-p.pop_mean)/p.pop_sd)*(p.sign<0?1:-1);}
    const zc=z==null?"var(--faint)":(z>2?COL[2]:z>1?COL[1]:COL[0]);
    return `<div class="ms ${v==null?"off":""}"><div class="lb">${l}</div>
      <div class="vl">${v==null?"—":v.toFixed(dp)}<em>${u}</em></div>
      <div class="nt" style="color:${zc}">${z==null?"not measured"
        :(z>=0?"+":"")+z.toFixed(1)+"σ for age and sex"}</div></div>`;}).join("");

}
boot();
</script></body></html>
